
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public configuration data can be read by anyone.
    match /_config/{docId} {
      allow read: if true;
    }

    // WARNING: DEVELOPMENT ONLY
    // All other data requires authentication to read or write.
    // This is for prototyping and debugging purposes and is NOT secure.
    // Proper security rules should be implemented before production.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
