
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: DEVELOPMENT ONLY
    // These rules are completely open for any authenticated user.
    // This is for prototyping and debugging purposes and is NOT secure.
    // Proper security rules should be implemented before production.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
